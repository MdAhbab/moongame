{
  "name": "mare-noctis",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Browser-based 3D orbital defense game. On a sphere, you cannot be everywhere.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run test && npm run build",
    "docs:controls": "tsx tools/print-controls.ts > docs/CONTROLS.md"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "bad-words": "4.1.5",
    "drizzle-orm": "0.45.2",
    "gsap": "3.15.0",
    "jose": "6.2.8",
    "nodemailer": "9.0.5",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simplex-noise": "4.0.3",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
