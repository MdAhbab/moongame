# ── Database ───────────────────────────────────────────────────────────────────
# Neon Postgres connection string (neon.tech → project settings → connection string)
DATABASE_URL=

# ── Session ────────────────────────────────────────────────────────────────────
# At least 32 random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ── WebAuthn (Passkeys) ────────────────────────────────────────────────────────
# Relying Party ID — must match the hostname the browser is visiting.
# Local dev: localhost
# Production: mare-noctis.vercel.app (or your custom domain, without https://)
RP_ID=localhost
# Human-readable name shown in the OS passkey prompt.
RP_NAME=Mare Noctis
# Full origin. Local dev: http://localhost:5173
RP_ORIGIN=http://localhost:5173

# ── Email (magic-link fallback) ────────────────────────────────────────────────
# Sender address for magic-link emails.
EMAIL_FROM=noreply@mare-noctis.example
# Standard SMTP credentials. Mailpit (https://mailpit.axllent.org) works for local dev.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ── Rate-limiting (optional production upgrade) ────────────────────────────────
# Without these, the in-process sliding-window limiter is used (fine for dev,
# resets per Vercel Function cold-start in production).
# Upstash Redis: https://console.upstash.com
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
